rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Returns true when a poll option map is well-formed and starts with no votes.
    function validPollOption(opt) {
      return opt.text is string && opt.text.size() > 0 && opt.voteCount == 0;
    }

    // Validates all options in the list (supports 2–6 entries).
    function validPollOptions(opts) {
      return opts.size() >= 2 && opts.size() <= 6
        && validPollOption(opts[0])
        && validPollOption(opts[1])
        && (opts.size() < 3 || validPollOption(opts[2]))
        && (opts.size() < 4 || validPollOption(opts[3]))
        && (opts.size() < 5 || validPollOption(opts[4]))
        && (opts.size() < 6 || validPollOption(opts[5]));
    }

    // Convenience accessor for the parent poll document data.
    function pollData(groupId, pollId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/polls/$(pollId)).data;
    }

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function currentAnonymousId(groupId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId;
    }

    function ownsUserReportNotification() {
      return exists(/databases/$(database)/documents/user_reports/$(request.resource.data.reportId))
        && get(/databases/$(database)/documents/user_reports/$(request.resource.data.reportId)).data.groupId == request.resource.data.groupId
        && get(/databases/$(database)/documents/user_reports/$(request.resource.data.reportId)).data.reporterAnonymousId == currentAnonymousId(request.resource.data.groupId);
    }

    function ownsMessageReportNotification() {
      return exists(/databases/$(database)/documents/message_reports/$(request.resource.data.reportId))
        && get(/databases/$(database)/documents/message_reports/$(request.resource.data.reportId)).data.groupId == request.resource.data.groupId
        && get(/databases/$(database)/documents/message_reports/$(request.resource.data.reportId)).data.reporterAnonymousId == currentAnonymousId(request.resource.data.groupId);
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      // Users can update their own doc but cannot touch the 'role' field,
      // preventing self-promotion.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      // Admins can update the role field exclusively.
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
      allow delete: if false;

      match /anonymousIdentities/{groupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if false;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
        && (
          // Join: identity must already exist and count increases by exactly 1.
          (request.resource.data.memberCount == resource.data.memberCount + 1
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)))
          ||
          // Leave: identity is deleted in the same batch so exists() would return
          // false for the post-batch state. Allow decrement-by-1 for any authed user;
          // the batch atomically deletes the identity, keeping the data consistent.
          request.resource.data.memberCount == resource.data.memberCount - 1
        );

      match /takenNicknames/{nickname} {
        allow read, write: if request.auth != null;
      }

      match /takenAvatarIndices/{index} {
        allow read, write: if request.auth != null;
      }

      // Tracks which anonymous IDs in this group belong to verified medics.
      // Readable by all members; writable only by the owner of that anonymousId
      // when they currently hold the 'medic' role. Admins can delete entries
      // to revoke the badge when demoting a medic.
      match /medicAnonymousIds/{anonymousId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId == anonymousId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'medic';
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      match /typing/{anonymousId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId == anonymousId;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId == request.resource.data.senderId
          && (
            // Regular text message
            ((!('type' in request.resource.data) || request.resource.data.type == 'text')
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            // Poll placeholder message (text is empty; content lives in /polls)
            (request.resource.data.type == 'poll'
              && 'pollId' in request.resource.data
              && request.resource.data.pollId is string
              && existsAfter(/databases/$(database)/documents/groups/$(groupId)/polls/$(request.resource.data.pollId))
              && request.resource.data.text == '')
          );
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      match /polls/{pollId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId == request.resource.data.creatorAnonymousId
          && request.resource.data.question is string
          && request.resource.data.question.size() > 0
          && request.resource.data.options is list
          && validPollOptions(request.resource.data.options)
          && request.resource.data.createdAt == request.time
          && request.resource.data.closedAt == null;

        // Creator can close the poll (set closedAt); voting updates options counts.
        allow update: if request.auth != null && (
          // Close: only the creator can set closedAt.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closedAt'])
            && resource.data.creatorAnonymousId == get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId)
          ||
          // Vote: options update must be coupled with a new vote document written in
          // the same transaction. This prevents arbitrary manipulation of vote counts.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options'])
            && resource.data.closedAt == null
            && !exists(/databases/$(database)/documents/groups/$(groupId)/polls/$(pollId)/votes/$(get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId))
            && existsAfter(/databases/$(database)/documents/groups/$(groupId)/polls/$(pollId)/votes/$(get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId)))
        );

        allow delete: if false;

        match /votes/{anonymousId} {
          // Only the voter can read their own vote.
          allow read: if request.auth != null
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId == anonymousId;

          // Vote once: create only, document ID must match the user's anonymousId.
          // Also validates the parent poll is still open and optionIndex is in bounds.
          allow create: if request.auth != null
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId == anonymousId
            && request.resource.data.keys().hasOnly(['optionIndex'])
            && request.resource.data.optionIndex is int
            && pollData(groupId, pollId).closedAt == null
            && pollData(groupId, pollId).createdAt > request.time - duration.value(24, 'h')
            && request.resource.data.optionIndex >= 0
            && request.resource.data.optionIndex < pollData(groupId, pollId).options.size();

          allow update, delete: if false;
        }
      }
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    match /user_reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'groupId',
          'groupName',
          'reportedAnonymousId',
          'reportedNickname',
          'reportedAvatarIndex',
          'reporterAnonymousId',
          'category',
          'reason',
          'description',
          'status',
          'createdAt',
        ])
        && request.resource.data.groupId is string
        && request.resource.data.groupName is string
        && request.resource.data.reportedAnonymousId is string
        && request.resource.data.reportedAnonymousId.size() > 0
        && request.resource.data.reportedNickname is string
        && request.resource.data.reportedAvatarIndex is int
        && request.resource.data.reporterAnonymousId == currentAnonymousId(request.resource.data.groupId)
        && request.resource.data.reportedAnonymousId != request.resource.data.reporterAnonymousId
        && request.resource.data.category in [
          'Spam',
          'Harassment',
          'Misinformation',
          'Abuse',
          'Other',
        ]
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['reviewed', 'dismissed']
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    match /message_reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'groupId',
          'groupName',
          'messageId',
          'messageText',
          'messageSenderAnonymousId',
          'messageSenderNickname',
          'messageSenderAvatarIndex',
          'reporterAnonymousId',
          'category',
          'details',
          'status',
          'createdAt',
        ])
        && request.resource.data.groupId is string
        && request.resource.data.groupName is string
        && request.resource.data.messageId is string
        && request.resource.data.messageId.size() > 0
        && request.resource.data.messageText is string
        && request.resource.data.messageText.size() > 0
        && request.resource.data.messageText.size() <= 2000
        && request.resource.data.messageSenderAnonymousId is string
        && request.resource.data.messageSenderAnonymousId.size() > 0
        && request.resource.data.messageSenderNickname is string
        && request.resource.data.messageSenderAvatarIndex is int
        && request.resource.data.reporterAnonymousId == currentAnonymousId(request.resource.data.groupId)
        && request.resource.data.category in [
          'Spam',
          'Misinformation',
          'Bullying',
          'LifeRisk',
          'Other',
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 2000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['reviewed', 'dismissed']
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    match /admin_notifications/{notificationId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'type',
          'reportId',
          'groupId',
          'groupName',
          'description',
          'isRead',
          'timestamp',
        ])
        && request.resource.data.type in ['user_report', 'message_report']
        && request.resource.data.reportId is string
        && request.resource.data.groupId is string
        && request.resource.data.groupName is string
        && request.resource.data.description is string
        && request.resource.data.isRead == false
        && request.resource.data.timestamp == request.time
        && (
          (request.resource.data.type == 'user_report'
            && ownsUserReportNotification())
          ||
          (request.resource.data.type == 'message_report'
            && ownsMessageReportNotification())
        );
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    // Reverse lookup for moderation (anonymousId → real userId). Never deleted
    // from the client so historical messages remain traceable after a user leaves.
    match /anonymousIdentities/{anonymousId} {
      allow create, update: if request.auth != null;
      allow delete: if false;
      allow read: if false;
    }
    
    match /medications/{medicationId} {
      allow read: if request.auth != null;
      // Only medics can create medication entries, and only for themselves
      // with a fixed set of fields to prevent data injection.
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'medic'
        && request.resource.data.submittedByUserId == request.auth.uid
        && request.resource.data.groupId is string
        && request.resource.data.status == 'approved'
        && request.resource.data.keys().hasOnly(
             ['groupId', 'name', 'description', 'status', 'submittedByUserId', 'timestamp']);
      allow update, delete: if false;
    }

    match /moderator_applications/{appId} {
      // Users can only submit their own application, forced into pending status
      // with only the expected fields — prevents self-approving or injecting
      // arbitrary data.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(
             ['userId', 'userEmail', 'licenseNumber', 'status', 'timestamp']);
      // Users can read their own; admins can read all.
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      // Only admins can update the status field (approve / deny).
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
