rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /anonymousIdentities/{groupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if false;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
        && (
          // Join: identity must already exist and count increases by exactly 1.
          (request.resource.data.memberCount == resource.data.memberCount + 1
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)))
          ||
          // Leave: identity is deleted in the same batch so exists() would return
          // false for the post-batch state. Allow decrement-by-1 for any authed user;
          // the batch atomically deletes the identity, keeping the data consistent.
          request.resource.data.memberCount == resource.data.memberCount - 1
        );

      match /takenNicknames/{nickname} {
        allow read, write: if request.auth != null;
      }

      match /takenAvatarIndices/{index} {
        allow read, write: if request.auth != null;
      }

      match /typing/{anonymousId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId == anonymousId;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId == request.resource.data.senderId
          && (
            // Regular text message
            ((!('type' in request.resource.data) || request.resource.data.type == 'text')
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            // Poll placeholder message (text is empty; content lives in /polls)
            (request.resource.data.type == 'poll'
              && 'pollId' in request.resource.data
              && request.resource.data.text == '')
          );
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      match /polls/{pollId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId == request.resource.data.creatorAnonymousId
          && request.resource.data.question is string
          && request.resource.data.question.size() > 0
          && request.resource.data.options is list
          && request.resource.data.options.size() >= 2
          && request.resource.data.options.size() <= 6
          && request.resource.data.closedAt == null;

        // Creator can close the poll (set closedAt); voting updates options counts.
        allow update: if request.auth != null && (
          // Close: only the creator can set closedAt.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closedAt'])
            && resource.data.creatorAnonymousId == get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId)
          ||
          // Vote: options update must be coupled with a new vote document written in
          // the same transaction. This prevents arbitrary manipulation of vote counts.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options'])
            && resource.data.closedAt == null
            && !exists(/databases/$(database)/documents/groups/$(groupId)/polls/$(pollId)/votes/$(get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId))
            && existsAfter(/databases/$(database)/documents/groups/$(groupId)/polls/$(pollId)/votes/$(get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId)))
        );

        allow delete: if false;

        match /votes/{anonymousId} {
          // Only the voter can read their own vote.
          allow read: if request.auth != null
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId == anonymousId;

          // Vote once: create only, document ID must match the user's anonymousId.
          allow create: if request.auth != null
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/anonymousIdentities/$(groupId)).data.anonymousId == anonymousId
            && request.resource.data.keys().hasOnly(['optionIndex'])
            && request.resource.data.optionIndex is int;

          allow update, delete: if false;
        }
      }
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    // Reverse lookup for moderation (anonymousId → real userId). Never deleted
    // from the client so historical messages remain traceable after a user leaves.
    match /anonymousIdentities/{anonymousId} {
      allow create, update: if request.auth != null;
      allow delete: if false;
      allow read: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
